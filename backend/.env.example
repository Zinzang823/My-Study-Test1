# Sao chép thành backend/.env.local (đã được .gitignore) và điền giá trị thật. Backend tự đọc file này khi chạy cục bộ.

# Địa chỉ người dùng mở trình duyệt; dùng cho OAuth redirect URI. Production bắt buộc là HTTPS.
APP_ORIGIN=http://localhost:5173

# postgresql://user:password@host:5432/dbname  (host ngoài localhost sẽ tự bật sslmode=require)
DATABASE_URL=

# Tùy chọn: bỏ trống thì chỉ dùng đăng nhập bằng email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email quản trị viên: chỉ được quyền khi đăng nhập bằng Google với email này (đã xác minh).
ADMIN_EMAIL=

# Tùy chọn: tính năng AI (gia sư giải thích câu sai, phân tích điểm yếu, ghi chú kiến thức).
AI_ENABLED=false
# Nhà cung cấp: groq (khuyên dùng, miễn phí & siêu nhanh), gemini hoặc anthropic.
AI_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=30
